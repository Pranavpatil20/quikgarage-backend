DEBUG=True
USE_SQLITE=true
DJANGO_SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Local Docker Postgres (when USE_SQLITE=false and no DATABASE_URL):
POSTGRES_DB=quikgarage
POSTGRES_USER=quikgarage
POSTGRES_PASSWORD=quikgarage
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Production (Render): set DATABASE_URL to Neon pooled connection string, e.g.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FIREBASE_CREDENTIALS_PATH=/app/firebase-credentials.json
# Or paste the full service-account JSON in one line (easier on Render):
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
